{
  "name": "@ari/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "mock": "node mock-server/server.mjs",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src e2e mock-server --max-warnings=0"
  },
  "dependencies": {
    "@ari/api-client": "workspace:*",
    "@ari/design-system": "workspace:*",
    "@ari/i18n": "workspace:*",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-query": "^5.59.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-intl": "^7.0.0",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
