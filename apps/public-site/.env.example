# Public site build-time configuration. Everything here is public (it ships in the static output).
SITE_URL=https://www.ari-pst.example
# Login entry: link target for "Sign in". Same-origin default per canonical decision C-03.
PUBLIC_PORTAL_URL=/app/
# Forms endpoint base. Empty = same origin (/api/v1/public/forms/{join|contact}).
PUBLIC_API_BASE=
# ALTCHA challenge endpoint. Empty = honeypot + minimum-fill-time fallback only.
PUBLIC_ALTCHA_CHALLENGE_URL=
# Analytics: OFF by default. Umami script loads only after the visitor accepts.
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
# Set to true on PR previews to add noindex everywhere.
PUBLIC_NOINDEX=false
