{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/he/index.html",
        "http://localhost/en/index.html",
        "http://localhost/he/about/index.html",
        "http://localhost/he/news/index.html",
        "http://localhost/he/patients/index.html",
        "http://localhost/he/join/index.html",
        "http://localhost/he/privacy/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 800,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638,
          "cpuSlowdownMultiplier": 4
        },
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 3500
          }
        ],
        "server-response-time": [
          "warn",
          {
            "maxNumericValue": 400
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 800000
          }
        ],
        "uses-responsive-images": "error",
        "uses-optimized-images": "error",
        "modern-image-formats": "warn",
        "offscreen-images": "warn",
        "font-display": "error",
        "unsized-images": "error",
        "is-crawlable": "error",
        "hreflang": "error",
        "canonical": "error",
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "html-lang-valid": "error",
        "image-alt": "error",
        "color-contrast": "error",
        "tap-targets": "error",
        "viewport": "error",
        "is-on-https": "error",
        "no-vulnerable-libraries": "error",
        "csp-xss": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
