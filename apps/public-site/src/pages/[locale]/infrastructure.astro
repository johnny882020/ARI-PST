---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
import Form from "../../components/Form.astro";
import { LOCALES, type Locale } from "../../content/schemas";
import { t, fmtDate } from "../../i18n/ui";
import { path } from "../../lib/paths";
import { page, list, hasTranslation, settings } from "../../lib/content";
import { eventLd, faqLd } from "../../lib/seo";
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;

const p = await page(locale, 'infrastructure');
const d = p.data;
const { Content } = await render(p);
const hasOther = await hasTranslation('pages', locale === 'he' ? 'en' : 'he', 'infrastructure');
const crumbs = [{ name: t(locale, 'home'), path: path(locale) }, { name: d.title, path: path(locale, 'infrastructure') }];
const notice = d.needs_review ? t(locale, 'reviewNotice') : '';
---
<BaseLayout locale={locale} title={d.title} description={d.description} slug="infrastructure" hasOther={hasOther} crumbs={crumbs} >
  <Crumbs locale={locale} crumbs={crumbs} />
  <h1>{d.title}</h1>
  {d.intro && <p class="lead">{d.intro}</p>}
  {notice && <p class="notice" role="note">{notice}</p>}
  <h2>{t(locale, 'layers')}</h2>
  <ul class="grid">{d.layers!.map((x) => <li class="card"><h3>{x.title}</h3><p>{x.text}</p></li>)}</ul>
  <h2>{t(locale, 'howItWorks')}</h2>
  <ol class="timeline">{d.how_it_works!.map((x) => <li><strong>{x.title}</strong>: {x.text}</li>)}</ol>
  <h2>{t(locale, 'standards')}</h2><p>{d.standards}</p>
  <div class="prose"><Content /></div>
</BaseLayout>
