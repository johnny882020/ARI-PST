---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Crumbs from "../../../components/Crumbs.astro";
import { LOCALES, type Locale } from "../../../content/schemas";
import { t, fmtDate } from "../../../i18n/ui";
import { path } from "../../../lib/paths";
import { page, list, hasTranslation } from "../../../lib/content";
import { newsArticleLd } from "../../../lib/seo";

export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const p = await page(locale, 'research-index');
const d = p.data;
const areas = (await list('research-areas', locale)).sort((a, b) => a.data.order - b.data.order);
const hasOther = await hasTranslation('pages', locale === 'he' ? 'en' : 'he', 'research-index');
const crumbs = [{ name: t(locale, 'home'), path: path(locale) }, { name: d.title, path: path(locale, 'research') }];
---
<BaseLayout locale={locale} title={d.title} description={d.description} slug="research" hasOther={hasOther} crumbs={crumbs}>
  <Crumbs locale={locale} crumbs={crumbs} />
  <h1>{d.title}</h1>
  <p class="lead">{d.intro}</p>
  <ul class="grid">{areas.map((a) => <li class="card"><h2 class="card-title"><a href={path(locale, `research/${a.data.slug}`)}>{a.data.name}</a></h2><p>{a.data.summary}</p></li>)}</ul>
</BaseLayout>
