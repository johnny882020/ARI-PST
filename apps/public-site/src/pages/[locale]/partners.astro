---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Crumbs from "../../components/Crumbs.astro";
import Form from "../../components/Form.astro";
import { LOCALES, type Locale } from "../../content/schemas";
import { t, fmtDate } from "../../i18n/ui";
import { path } from "../../lib/paths";
import { page, list, hasTranslation, settings } from "../../lib/content";
import { eventLd, faqLd } from "../../lib/seo";
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;

const p = await page(locale, 'partners-index');
const d = p.data;
const { Content } = await render(p);
const hasOther = await hasTranslation('pages', locale === 'he' ? 'en' : 'he', 'partners-index');
const crumbs = [{ name: t(locale, 'home'), path: path(locale) }, { name: d.title, path: path(locale, 'partners') }];
const partners = (await list("partners", locale)).sort((a, b) => a.data.order - b.data.order);
const notice = d.needs_review ? t(locale, 'reviewNotice') : '';
---
<BaseLayout locale={locale} title={d.title} description={d.description} slug="partners" hasOther={hasOther} crumbs={crumbs}>
  <Crumbs locale={locale} crumbs={crumbs} />
  <h1>{d.title}</h1>
  {d.intro && <p class="lead">{d.intro}</p>}
  {notice && <p class="notice" role="note">{notice}</p>}
  <ul class="grid">{partners.map((x) => <li class="card"><h2 class="card-title"><bdi>{x.data.name}</bdi></h2><p><span class="chip"><bdi>{x.data.title}</bdi></span></p><p class="muted small">{t(locale, 'country')}: {x.data.country}</p><p>{x.data.summary}</p>{x.data.url && <p><a href={x.data.url} rel="noopener">{x.data.url.replace('https://', '')}</a></p>}</li>)}</ul>
  <p class="muted small">{t(locale, 'partnersNameOnly')}</p>
</BaseLayout>
