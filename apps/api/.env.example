# apps/api environment. Source of truth: apps/api/src/config.ts (+ src/lib/db-url.ts, src/jobs/run.ts).
# Copy to .env for local work. Never commit real values. Synthetic data only (GATE-PROD-DATA).
# R = required in production. Everything else is optional.

# --- runtime
NODE_ENV=development                 # R  production | development | test
PORT=8080                            #    Render sets PORT itself
HOST=0.0.0.0
PUBLIC_ORIGIN=http://localhost:8080  # R* same origin for SPA and API (C-03). *Falls back to RENDER_EXTERNAL_URL on Render.
WEB_DIST_DIR=apps/web/dist           #    the API serves the built SPA from here at /
COOKIE_SECURE=true                   #    keep true (cookies are __Host- prefixed)
# RENDER_GIT_COMMIT                  #    set by Render. Shown as "version" in /livez and /readyz. APP_VERSION is the fallback.

# --- data guard
DATA_CLASSIFICATION=synthetic        # R  anything else makes the API refuse to start unless GATE_PROD_DATA_CLOSED=true
# GATE_PROD_DATA_CLOSED=true         #    only by ADR after GATE-PROD-DATA. Also blocks the synthetic seed.
DEMO_MODE=false                      #    true on the free demo Blueprint; reported in /livez (checks.demo)

# --- database (C-06). Option A, local: one explicit URL that logs in as app_runtime.
DATABASE_URL=postgres://app_runtime@127.0.0.1:55433/ari_pst_api
# Option B, Render: parts + one password per role. The API uses app_runtime, jobs use app_readonly_bg.
# DB_HOST=            # R (B)
# DB_PORT=5432
# DB_NAME=            # R (B)
# DB_SSLMODE=         #    e.g. require, for an external connection
# DB_PASSWORD_RUNTIME=   # R (B)  API
# DB_PASSWORD_BG=        # R (B)  cron jobs (DATABASE_URL_BG overrides)
DB_POOL_MAX=10
# Pre-deploy step only (scripts/render-predeploy.mjs). The API deletes these from its process environment at start.
# DATABASE_URL_OWNER=    # R on Render: the connection string of the database user Render created
# DB_PASSWORD_MIGRATOR=  # R on Render
# PREDEPLOY_SKIP_BOOTSTRAP=true   # roles were created by hand
# DATABASE_URL_BREAKGLASS=        # export job only; app_break_glass is NOLOGIN until an approved window

# --- secrets (R in production; generated by Render)
IP_HASH_SALT=dev-only-salt-change-me
SECRETS_KEY=dev-only-secrets-key-change-me    # encrypts TOTP secrets at rest. Changing it locks out every TOTP user.

# --- synthetic seed (pre-deploy step). Never with DATA_CLASSIFICATION other than synthetic.
SEED_SYNTHETIC=false                 #    true: seed after migration. IS_PULL_REQUEST=true (Render previews) does the same.
SEED_PROFILE=preview                 #    tiny (40 samples) | preview (600 samples)
# SEED_USER_PASSWORD=                #    required when seeding, min 16 chars. Sign-in list: node scripts/seed-credentials.mjs

# --- public site (the only cross-origin caller; only POST /api/v1/public/forms/*; no credentials)
# PUBLIC_SITE_ORIGIN=https://ari-public.onrender.com
CONTACT_INBOX=contact@portal.invalid

# --- mail. Default: smtp when SMTP_URL is set, else console (mail is not sent). Required when data is not synthetic.
# MAIL_TRANSPORT=console
# SMTP_URL=
# MAIL_FROM=ARI-PST Portal <no-reply@portal.invalid>

# --- object store (import files, exports). Default: s3 when S3_BUCKET is set, else memory. Required when data is not synthetic.
# OBJECT_STORE=memory                # memory | localfs | s3
# OBJECT_STORE_DIR=/tmp/ari-pst-objects
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=                 # read by the AWS SDK
# AWS_SECRET_ACCESS_KEY=

# --- tuning
# WEBAUTHN_RP_ID= WEBAUTHN_RP_NAME= WEBAUTHN_ORIGIN=    (default: from PUBLIC_ORIGIN)
# RATE_TIGHT_PER_MIN=20  RATE_GENERAL_PER_MIN=600
# ARGON_MEMORY_KIB=19456  ARGON_TIME_COST=2  ARGON_PARALLELISM=1
# OUTBOX_INTERVAL_MS=15000  VALIDATE_RESPONSES=false  DB_SET_LOCAL_ROLE=false  OPENAPI_PATH=
# HEARTBEAT_URL_<JOB>=   e.g. HEARTBEAT_URL_AUDIT_VERIFY: pinged after a successful cron run
