{
  "name": "@ari/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "gen": "openapi-typescript ../contracts/openapi.yaml -o src/generated/schema.d.ts",
    "gen:check": "pnpm gen && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "openapi-fetch": "^0.13.0" },
  "devDependencies": { "openapi-typescript": "^7.4.0", "typescript": "^5.6.0", "vitest": "^2.1.0" }
}
